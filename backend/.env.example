# Hunar AI Voice API
HUNAR_API_KEY=your-hunar-api-key
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1

# People Data Labs
PDL_API_KEY=your-pdl-api-key

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Backend
DATABASE_URL=sqlite+aiosqlite:///./hunar_hr.db
WEBHOOK_BASE_URL=http://your-public-ip:8000

# CAMARA / GSMA Open Gateway Device Location Verification (attendance, Option B)
# Leave unset to run with USSD-only verification; the telecom-verify endpoint 503s until set.
# Auth is private_key_jwt (RFC 7523) — a JWT you sign with a private key, not a plain secret.
CAMARA_TOKEN_URL=
CAMARA_BASE_URL=
CAMARA_CLIENT_ID=
CAMARA_KEY_ID=
CAMARA_KEY_ALG=PS256
CAMARA_SCOPE=location-verification:verify
CAMARA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# Future: WhatsApp Business API
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
